# Normalize text files by default.
* text=auto

# Keep Unix-style line endings for source and Unix tooling.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.proto text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
justfile text eol=lf

# Keep Windows-style line endings for Windows scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary