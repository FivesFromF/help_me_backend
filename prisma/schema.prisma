datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Citizen {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognitoId           String           @unique @map("cognito_id")
  email               String           @unique
  fullName            String           @default("") @map("full_name")
  phone               String?
  avatarUrl           String?          @map("avatar_url")
  dateOfBirth         DateTime?        @map("date_of_birth") @db.Date
  gender              String?
  address             String?
  cccdNumber          String?          @unique @map("cccd_number")
  faceEmbedding       Unsupported("vector(512)")? @map("face_embedding")
  emergencyContacts   Json?            @map("emergency_contacts")
  isProfileUpdated    Boolean          @default(false) @map("is_profile_updated")
  isVerified          Boolean          @default(false) @map("is_verified")
  firstDeclareProfile Boolean          @default(false) @map("first_declare_profile")
  consentRegulation   Boolean          @default(false) @map("consent_regulation")
  createdAt           DateTime?        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime?        @default(now()) @map("updated_at") @db.Timestamptz

  medicalRecord       MedicalRecord?
  nfcTags             NfcTag[]
  qrCodes             QrCode[]
  emergencyReports    EmergencyReport[]
  accessComplaints    AccessComplaint[]

  @@map("citizens")
}

model Admin {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cognitoId String    @unique @map("cognito_id")
  email     String    @unique
  fullName  String    @map("full_name")
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("admins")
}

model MedicalRecord {
  citizenId          String    @id @map("citizen_id") @db.Uuid
  citizen            Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  distinguishingMarks String?  @map("distinguishing_marks")
  bloodGroup         String?   @map("blood_group")
  allergies          String[]  @default([])
  backgroundDiseases String[]  @default([]) @map("background_diseases")
  currentMedications String[]  @default([]) @map("current_medications")
  notes              String?
  lastUpdated        DateTime? @default(now()) @map("last_updated") @db.Timestamptz

  @@map("medical_records")
}

model NfcTag {
  id           String    @id
  name         String?
  status       String    @default("INACTIVE")
  citizenId    String?   @map("citizen_id") @db.Uuid
  citizen      Citizen?  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  registeredAt DateTime? @default(now()) @map("registered_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz

  @@map("nfc_tags")
}

model QrCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String?
  status     String    @default("INACTIVE")

  /// Nullable, giống nfc_tags: người dùng "xoá" mã QR thì gỡ liên kết chủ sở hữu chứ không xoá hàng.
  /// Giữ lại hàng là giữ lại lịch sử - `last_used_at` cho biết mã từng bị quét lúc nào, và một mã đã
  /// in ra giấy vẫn tồn tại ngoài đời dù chủ nhân không dùng nữa. Mã không có chủ không định danh
  /// được ai - xem nhánh QR trong read-server/scan.routes.ts.
  citizenId  String?   @map("citizen_id") @db.Uuid
  citizen    Citizen?  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  @@map("qr_codes")
}

model AccessSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responderId String   @map("responder_id")
  victimId    String   @map("victim_id") @db.Uuid
  method      String?
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  /// ACTIVE | EXPIRED | COMPLAINED. Hàng hết hạn được ĐỔI TRẠNG THÁI chứ không xoá: chính những
  /// hàng này là lịch sử truy cập mà `emergency_reports.access_session_id` trỏ tới, và là bằng
  /// chứng ai đã mở hồ sơ y tế của ai - xoá đi là mất dấu vết kiểm toán.
  ///
  /// COMPLAINED: nạn nhân đã khiếu nại lần truy cập này. Đây là trạng thái CHUNG CUỘC - quét lại
  /// thẻ cũng không cấp lại quyền, nếu không người bị khiếu nại chỉ cần quét thêm lần nữa là xoá
  /// sạch khiếu nại.
  status      String   @default("ACTIVE")

  /// Lý do nạn nhân đưa ra khi khiếu nại, và thời điểm khiếu nại.
  complaintReason String?   @map("complaint_reason")
  complainedAt    DateTime? @map("complained_at") @db.Timestamptz

  /// Toạ độ nơi responder quét (NFC / QR / khuôn mặt) - trả lời "tìm thấy người này ở đâu".
  ///
  /// Nullable một cách có chủ đích: máy có thể từ chối quyền định vị, ở tầng hầm không bắt được
  /// tín hiệu, hoặc hết thời gian chờ. Chặn một ca cấp cứu vì thiếu toạ độ là đánh đổi sai - hồ sơ
  /// y tế quan trọng hơn việc biết chính xác vị trí. Kiểu String để khớp `emergency_reports`.
  scanLat String? @map("scan_lat")
  scanLon String? @map("scan_lon")
  reports     EmergencyReport[]

  /// Khiếu nại của nạn nhân về chính phiên truy cập này, nếu có.
  complaint   AccessComplaint?

  @@unique([responderId, victimId])
  @@index([expiresAt])
  @@index([status])
  @@map("access_sessions")
}

/// Khiếu nại của công dân về việc ai đó đã mở hồ sơ y tế của mình mà không có lý do chính đáng.
///
/// Gắn thẳng vào `access_sessions`: mỗi phiên chỉ khiếu nại được một lần, và chính hàng phiên đó là
/// bằng chứng - ai mở, mở lúc nào, bằng phương thức gì. Đây là lý do phiên hết hạn được giữ lại
/// thay vì xoá: xoá phiên là xoá luôn khả năng khiếu nại.
///
/// Chỉ nạn nhân (`victim_id` của phiên) mới được nộp.
model AccessComplaint {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Một phiên chỉ khiếu nại một lần; nộp lại sẽ trả về 409.
  accessSessionId String        @unique @map("access_session_id") @db.Uuid
  accessSession   AccessSession @relation(fields: [accessSessionId], references: [id], onDelete: Cascade)

  complainantId   String        @map("complainant_id") @db.Uuid
  complainant     Citizen       @relation(fields: [complainantId], references: [id], onDelete: Cascade)

  /// NO_EMERGENCY | UNKNOWN_RESPONDER | DATA_MISUSE | OTHER
  reason          String
  description     String?

  /// PENDING | REVIEWING | UPHELD | DISMISSED
  status          String        @default("PENDING")
  reviewedBy      String?       @map("reviewed_by")
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz
  resolutionNote  String?       @map("resolution_note")

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("access_complaints")
}

model EmergencyReport {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId           String?   @map("reporter_id")
  victimId             String?   @map("victim_id") @db.Uuid
  victim               Citizen?  @relation(fields: [victimId], references: [id])
  accessSessionId      String?        @map("access_session_id") @db.Uuid
  accessSession        AccessSession? @relation(fields: [accessSessionId], references: [id], onDelete: SetNull)
  locationLat          String    @map("location_lat")
  locationLon          String    @map("location_lon")
  situationDescription String?   @map("situation_description")
  status               String    @default("PENDING")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("emergency_reports")
}
