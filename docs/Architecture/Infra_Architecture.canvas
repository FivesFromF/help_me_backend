		{"id": "edge-alb-write", "fromNode": "node-alb", "fromSide": "right", "toNode": "node-write-service", "toSide": "left", "label": "Target Group /write/*"},
		{"id": "edge-alb-read", "fromNode": "node-alb", "fromSide": "right", "toNode": "node-read-service", "toSide": "left", "label": "Target Group /read/*"},
		{"id": "edge-sqs-ai", "fromNode": "node-sqs-queue", "fromSide": "bottom", "toNode": "node-ai-service", "toSide": "top", "label": "Long Polling Consumer"},
		{"id": "edge-ai-rds", "fromNode": "node-ai-service", "fromSide": "right", "toNode": "node-rds-postgres", "toSide": "left", "label": "pgvector Distance Search"},
		{"id": "edge-ai-scanjobs", "fromNode": "node-ai-service", "fromSide": "right", "toNode": "node-dynamo-scanjobs", "toSide": "left", "label": "Save Match Result"},
		{"id": "edge-ai-sessions", "fromNode": "node-ai-service", "fromSide": "right", "toNode": "node-dynamo-sessions", "toSide": "left", "label": "Create Access Session"},
		{"id": "edge-ai-events", "fromNode": "node-ai-service", "fromSide": "top", "toNode": "node-eventbridge-emergency", "toSide": "bottom", "label": "Publish victim.identified"},
		{"id": "edge-read-scanjobs", "fromNode": "node-read-service", "fromSide": "right", "toNode": "node-dynamo-scanjobs", "toSide": "left", "label": "Fetch Job Status"},
		{"id": "edge-write-scanjobs", "fromNode": "node-write-service", "fromSide": "right", "toNode": "node-dynamo-scanjobs", "toSide": "left", "label": "Initialize PENDING Job"}
	]
}