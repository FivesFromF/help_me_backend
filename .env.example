# ─────────────────────────────────────────────────────────────────────────────
# HelpMe backend — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is gitignored. Never commit real values; never paste them into docs.
#
# The values below are the LOCAL DEVELOPMENT defaults, and they match what
# `docker-compose.yaml` and `local-infra/serverless.yml` already agree on. They
# assume the write/read servers run on the HOST while Postgres, DynamoDB and the
# queue run in Docker (see docs/Runbooks/Local_Testing.md).
#
# Cloud values come from `terraform output` in infra/ — docs/Runbooks/Cloud_Deployment.md.
#
# ⚠ dotenv never overwrites a variable already present in process.env, so editing
#   this file will not change a shell that is already running. Restart the shell,
#   or override per command (env -u VAR npm run test:api).
# ─────────────────────────────────────────────────────────────────────────────


# ── Core ─────────────────────────────────────────────────────────────────────

NODE_ENV=development

# PORT is per-service and already defaults correctly on its own: the write server
# binds 8080, the read server 8081. Set it only to move one of them, and note that
# a single value here applies to whichever service you start.
# PORT=8080

# Postgres 16 + pgvector, from `docker compose up -d db`.
# Host-run servers use localhost; inside compose the host is `db` instead.
DATABASE_URL=postgres://postgres:password@localhost:5432/helpme


# ── Secrets ──────────────────────────────────────────────────────────────────

# The HMAC key that mints and verifies every NFC and QR hash ID
# (src/services/hash.service.ts, compared with timingSafeEqual).
#
# `helpme-secret-key` is the shared local default — it is also the fallback baked
# into the route handlers, so local dev works with it unset. In the cloud this MUST
# be a strong random value supplied through Terraform.
#
# ⚠ Rotating this invalidates every NFC tag and QR code already issued: existing
#   hashes stop verifying, so previously burned tags will no longer resolve.
SYSTEM_SECRET=helpme-secret-key


# ── Authentication (Cognito) ─────────────────────────────────────────────────

# From `terraform output`. Can stay empty for local work that uses header auth.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ⚠ DANGER — SKIP_AUTH=true makes `authenticate` (src/shared/middleware/auth.ts)
#   trust the x-cognito-id and x-role REQUEST HEADERS instead of validating a
#   Cognito JWT. Any caller can then claim to be any user, including an admin.
#
#   It exists so the in-process API suite can authenticate without Cognito. Keep it
#   false everywhere else; neither docker-compose nor Terraform sets it, which is
#   why the same header request that succeeds in-process returns 401 in a container.
#
#   The flag is read into a module constant at import time, so a script that
#   authenticates by header must assign it BEFORE any import that reaches a router.
SKIP_AUTH=false


# ── AWS region and local emulator endpoints ──────────────────────────────────

AWS_REGION=ap-southeast-1

# S3 and EventBridge come from `local-infra` running on the HOST; DynamoDB is a
# compose service. Point these at localhost from the host, or at
# host.docker.internal from inside a container.
#
# Leave all three UNSET when deploying: the clients then omit the endpoint entirely
# and the AWS SDK provider chain resolves the real service with the task role.
S3_ENDPOINT=http://localhost:4569
DYNAMODB_ENDPOINT=http://localhost:8001
EVENTBRIDGE_ENDPOINT=http://localhost:4010

# Blanket fallback, consulted only when the specific endpoint above is unset.
# AWS_ENDPOINT_URL=

# Legacy last-resort fallback, still read by the S3, events and job services.
# This project does not run LocalStack; prefer the specific endpoints above.
# LOCALSTACK_URL=

# S3 credentials are NOT read from here. When an endpoint is set, s3.service.ts
# hardcodes S3RVER/S3RVER, because serverless-s3-local wraps s3rver, which registers
# exactly that one key pair and rejects every other key with 403 before it even
# checks the signature.


# ── Buckets, tables and buses ────────────────────────────────────────────────

AWS_S3_BUCKET=helpme-avatars-local
SCAN_JOBS_TABLE=helpme-scan-jobs
AUDIT_TABLE_NAME=helpme-audit-logs

# ⚠ The local and cloud bus names genuinely differ. local-infra defines
#   `helpme-system-bus`, while Terraform builds `${project_name}-core-system-bus`
#   and project_name defaults to `help-me` — so the deployed bus is
#   `help-me-core-system-bus`. Take cloud values from `terraform output`.
CORE_SYSTEM_BUS_NAME=helpme-system-bus
EMERGENCY_BUS_NAME=helpme-emergency-bus

# Consumed by src/shared/services/ai.service.ts to invoke the AI Lambda by name.
# Unused on the path where the AI service runs as an SQS consumer.
AI_LAMBDA_NAME=


# ── Email (next-of-kin notification) ─────────────────────────────────────────

# The notification worker sends here. local-infra assumes a catcher on
# localhost:1025 (MailHog / Mailpit); point at real SMTP to send real mail.
# SMTP_FROM falls back to SMTP_USER when omitted, and SMTP_PORT defaults to 587.
#
# ⚠ `npm run test:notify -- you@example.com` sends ONE REAL email through whatever
#   is configured here. It is opt-in for exactly that reason.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ── Python AI worker (src/services/ai-server) ────────────────────────────────
#
# docker-compose already sets all of these for the composed `ai-server`. You only
# need them when running the worker on the host with `python main.py`.

# ⚠ Opt-in local emulation, and the single most expensive flag in this file to get
#   wrong. Only when this is exactly "true" does worker.py use localhost endpoints
#   and dummy credentials. Unset, boto3 resolves real AWS and uses the task role —
#   which is what you want deployed, and what you must NOT have locally.
#
#   Inverting this cost a day once: unconditional localhost defaults meant the
#   deployed Fargate worker polled itself and overrode its own ECS task role while
#   reporting RUNNING the whole time. Enrollment jobs stuck at PENDING with the
#   queue showing Available > 0 and NotVisible: 0 always mean nothing is consuming.
LOCAL_AWS_EMULATION=true

# ElasticMQ, a compose service. From inside a container this is elasticmq:9324.
AI_JOBS_QUEUE_URL=http://localhost:9324/queue/helpme-ai-jobs-queue

# The worker reads its own endpoint overrides (compose supplies these):
# SQS_ENDPOINT_URL=http://localhost:9324
# S3_ENDPOINT_URL=http://localhost:4569
