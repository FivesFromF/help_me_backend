# Application Environment
APP_ENV=development
SERVER_ADDRESS=0.0.0.0:8080

# Database Configuration - Master
DB_MASTER_DSN=postgres://app:app@postgres-master:5432/app_db?sslmode=disable

# Database Configuration - Slave (Read Replica)
DB_SLAVE_DSN=postgres://app:app@postgres-slave:5432/app_db?sslmode=disable

# Database Connection Pool
DB_MAX_CONNS=10

# Dragonfly Cache (Redis Alternative)
DRAGONFLY_ADDR=dragonfly:6379
DRAGONFLY_PASSWORD=dragonfly-secure-password-change-me
DRAGONFLY_DB=0
CACHE_TTL_SECONDS=300

# L1 Cache - Otter (In-Memory)
OTTER_INITIAL_CAPACITY=100000
OTTER_MAX_COST=1000000
OTTER_USERS_LIST_COST_PER_ITEM=1
OTTER_MARKER_COST=1

# JWT Authentication
JWT_SECRET=super-secret-change-me

# Logging Color Settings (development)
FORCE_COLOR=1

# ============================================
# Docker Compose Infrastructure Settings
# ============================================

# PostgreSQL Master Port
POSTGRES_MASTER_PORT=15432

# PostgreSQL Slave Port
POSTGRES_SLAVE_PORT=15433

# PostgreSQL Container Internal Port
POSTGRES_CONTAINER_PORT=5432

# PostgreSQL Superuser Password
POSTGRES_SUPERUSER_PASSWORD=postgres

# PostgreSQL Application User
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=app

# PostgreSQL Database Name
POSTGRES_APP_DATABASE=app_db

# PostgreSQL Replication Configuration
POSTGRES_REPLICATION_USER=repl_user
POSTGRES_REPLICATION_PASSWORD=repl_password
POSTGRES_MASTER_HOST=postgres-master

# Dragonfly Cache Port
DRAGONFLY_PORT=6379
